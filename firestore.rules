rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    // A user may only ever touch their own document.
    match /users/{uid} {
      allow get, list: if isOwner(uid);
      allow create, update: if isOwner(uid);
      allow delete: if false;

      // Audit trail. Written exclusively by the Cloud Function through the
      // Admin SDK, which bypasses these rules entirely, so clients get no write.
      match /alertLog/{entryId} {
        allow read: if isOwner(uid);
        allow write: if false;
      }
    }

    // Disaster alerts are curated by operators; clients read only.
    match /alerts/{alertId} {
      allow read: if isSignedIn();
      allow write: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
